[codespell]
skip = .git,node_modules,.claude*,.next,out,dist,coverage,playwright-report,test-results,.venv,venv,__pycache__,.pytest_cache,package-lock.json,pnpm-lock.yaml,docs/contributing,./src/generated*,assets,fixtures,data/exports/*,.codespellrc
ignore-words-list = organise,organised,organisation,organisations,modelling,behaviour,licence,programme,defence,optimisation,normalise,colour,afterAll,abd,mane,tread,ot,brunch,rouge,te,trough,goole,unparseable,artic,bootle,ons,linz,mappin
check-hidden = false
quiet-level = 3
